{
  "name": "JobHunter",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "web/main.py"] },
    "vscode": {
      "settings": {},
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt -r requirements-dev.txt",
  "postAttachCommand": {
    "server": "JOB_HUNTER_DEMO=1 uvicorn web.main:app --host 0.0.0.0 --port 8600 --reload"
  },
  "portsAttributes": {
    "8600": { "label": "JobHunter", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [8600]
}
